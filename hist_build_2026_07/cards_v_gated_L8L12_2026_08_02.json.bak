  "year": 1785,
  "date_start": "1785-01-19",
  "date_end": "1789-01-30",
  "place": "Sông Tiền (Rạch Gầm - Xoài Mút) và Thăng Long",
  "actors": [
   "Nguyễn Huệ - Quang Trung",
   "Nguyễn Ánh",
   "Tôn Sĩ Nghị",
   "Sầm Nghi Đống",
