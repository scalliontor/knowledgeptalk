 {
  "name": "Cuộc Tổng tiến công và nổi dậy Xuân Mậu Thân 1968",
  "kind": "campaign",
  "year": 1968,
  "date_start": "1968-01-30",
  "date_end": "1968-09-30",
  "place": "các đô thị miền Nam Việt Nam",
  "actors": [
   "Quân giải phóng miền Nam",
   "Quân đội nhân dân Việt Nam",
