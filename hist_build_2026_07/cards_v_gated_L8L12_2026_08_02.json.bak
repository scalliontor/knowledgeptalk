 {
  "name": "Đại hội đại biểu lần thứ nhất của Đảng (3/1935)",
  "kind": "event",
  "year": 1935,
  "date_start": "1935-03-27",
  "date_end": "1935-03-31",
  "place": "Ma Cao (Trung Quốc)",
  "actors": [
   "Lê Hồng Phong",
   "Ban lãnh đạo hải ngoại của Đảng"
