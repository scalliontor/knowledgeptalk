 {
  "name": "Cách mạng tháng Tám năm 1945",
  "kind": "event",
  "year": 1945,
  "date_start": "1945-08-14",
  "date_end": "1945-08-28",
  "place": "Cả nước, tiêu biểu Hà Nội, Huế, Sài Gòn",
  "actors": [
   "Hồ Chí Minh",
   "Mặt trận Việt Minh",
