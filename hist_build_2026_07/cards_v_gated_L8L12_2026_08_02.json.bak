  "kind": "campaign",
  "year": 1953,
  "date_start": "1953-04-08",
  "date_end": "1953-05-18",
  "place": "Thượng Lào (Sầm Nưa, Xiêng Khoảng, Phongxalì)",
  "aliases": [
   "chiến dịch Thượng Lào 1953",
