 {
  "name": "Thương cảng Hội An thế kỉ XVI - XVIII",
  "kind": "place",
  "year": null,
  "date_start": "1600",
  "date_end": "1800",
  "place": "Hội An, Quảng Nam",
  "actors": [
   "Chúa Nguyễn",
   "Thương nhân Nhật Bản",
   "Thương nhân Trung Quốc",
