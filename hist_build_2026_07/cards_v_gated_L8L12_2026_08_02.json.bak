 {
  "name": "Liên Xô xây dựng chủ nghĩa xã hội (1921-1941)",
  "kind": "period",
  "aliases": [
   "công cuộc xây dựng chủ nghĩa xã hội ở Liên Xô",
   "Chính sách kinh tế mới",
