  "kind": "battle",
  "year": 1789,
  "date_start": "1789-01-25",
  "date_end": "1789-01-30",
  "place": "Ngọc Hồi, Khương Thượng - Đống Đa và Thăng Long",
  "actors": [
   "Quang Trung (Nguyễn Huệ)",
