  "date_start": "1945-03-09",
  "date_end": "1945-03-10",
  "place": "Toàn Đông Dương, các thành phố Hà Nội, Hải Phòng, Sài Gòn",
  "actors": [
   "quân đội Nhật Bản",
   "thực dân Pháp",
   "Bảo Đại",
   "Trần Trọng Kim"
