  "name": "Cuộc Tổng tiến công và nổi dậy Xuân 1975",
  "kind": "campaign",
  "year": 1975,
  "date_start": "1975-03-04",
  "date_end": "1975-04-30",
  "place": "Miền Nam Việt Nam",
  "aliases": [
   "Đại thắng mùa Xuân 1975",
   "Chiến dịch Hồ Chí Minh",
