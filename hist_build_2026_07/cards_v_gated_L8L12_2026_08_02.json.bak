  "place": "Đàng Trong, Đàng Ngoài và Rô-ma (Ý)",
  "actors": [
   "Francisco de Pina",
   "Alexandre de Rhodes",
   "Gaspar do Amaral",
   "Antonio Barbosa"
  ],
  "aliases": [
