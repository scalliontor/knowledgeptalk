 {
  "name": "Chiến dịch Điện Biên Phủ (13/3 - 7/5/1954)",
  "kind": "event",
  "year": 1954,
  "date_start": "1954-03-13",
  "date_end": "1954-05-07",
  "place": "thung lũng Mường Thanh, Điện Biên Phủ (Lai Châu cũ, nay là tỉnh Điện Biên)",
  "actors": [
