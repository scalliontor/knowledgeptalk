 {
  "name": "Trận Vạn Tường (18/8/1965)",
  "kind": "battle",
  "year": 1965,
  "date_start": "1965-08-18",
  "date_end": "1965-08-18",
  "place": "Vạn Tường, Bình Sơn, Quảng Ngãi",
  "actors": [
   "lính thủy đánh bộ Mĩ",
   "Trung đoàn Ba Gia",
   "quân giải phóng"
