  "name": "Đại hội đại biểu toàn quốc lần thứ III của Đảng (9/1960)",
  "kind": "event",
  "year": 1960,
  "date_start": "1960-09-05",
  "date_end": "1960-09-10",
  "place": "Hà Nội",
