 {
  "name": "Kế hoạch Nava (7/1953) và cuộc tiến công chiến lược Đông - Xuân 1953 - 1954",
  "kind": "event",
  "year": 1953,
  "date_start": "1953-07",
  "date_end": "1954-02",
  "place": "Đông Dương",
  "actors": [
